@model IEnumerable<BogsyVideoStore.Models.ViewModels.VideoInventoryReportViewModel>
@{
    ViewData["Title"] = "Video Inventory Report";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>📊 Video Inventory Status Report</h2>
    <button onclick="window.print()" class="btn btn-outline-secondary">🖨️ Print Report</button>
</div>

<div class="card shadow-sm">
    <div class="card-body p-0">
        <table class="table table-bordered table-hover m-0">
            <thead class="table-dark">
                <tr>
                    <th>Title</th>
                    <th>Category</th>
                    <th class="text-center bg-success">In (Available)</th>
                    <th class="text-center bg-warning text-dark">Out (Rented)</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td class="fw-bold">@item.Title</td>
                        <td>@item.Category</td>
                        <td class="text-center fw-bold text-success">@item.QuantityIn</td>
                        <td class="text-center fw-bold text-danger">@item.QuantityOut</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
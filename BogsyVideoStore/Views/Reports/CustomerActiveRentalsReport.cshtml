@model IEnumerable<BogsyVideoStore.Models.ViewModels.CustomerActiveRentalsViewModel>
@{
    ViewData["Title"] = "Customer Active Rentals";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>📋 Customer Active Rentals Report</h2>
    <button onclick="window.print()" class="btn btn-outline-secondary">🖨️ Print Report</button>
</div>

@if (!Model.Any())
{
    <div class="alert alert-info">There are currently no active video rentals.</div>
}
else
{
    @foreach (var customer in Model)
    {
        <div class="card mb-4 shadow-sm">
            <div class="card-header bg-dark text-white d-flex justify-content-between">
                <h5 class="m-0">👤 @customer.CustomerName</h5>
                <span>Contact: @customer.ContactNumber</span>
            </div>
            <div class="card-body p-0">
                <table class="table table-hover m-0">
                    <thead class="table-light">
                        <tr>
                            <th>Video Title</th>
                            <th>Category</th>
                            <th>Rent Date</th>
                            <th>Due Date</th>
                            <th>Status / Penalty</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var rental in customer.ActiveRentals)
                        {
                            <tr>
                                <td class="fw-bold">@rental.VideoTitle</td>
                                <td>@rental.Category</td>
                                <td>@rental.RentDate.ToString("MMM dd, yyyy")</td>
                                <td>@rental.DueDate.ToString("MMM dd, yyyy")</td>
                                <td>
                                    @if (rental.DaysOverdue > 0)
                                    {
                                        <span class="badge bg-danger">
                                            @rental.DaysOverdue Day(s) Overdue (Penalty: ₱@rental.OverdueFee.ToString("N2"))
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-success">On Schedule</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
}
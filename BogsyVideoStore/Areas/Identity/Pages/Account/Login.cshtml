@page
@model LoginModel

@{
    ViewData["Title"] = "Log in";
}

<div class="d-flex flex-column justify-content-center text-white shadow-lg"
     style="margin-left: calc(-50vw + 50%); margin-right: calc(-50vw + 50%); width: 100vw; min-height: 88vh; margin-top: -1rem; margin-bottom: -3rem; background: linear-gradient(rgba(0, 0, 0, 0.70), rgba(0, 0, 0, 0.70)), url('/images/BackgroundImage.jpeg') center/cover no-repeat;">

    <div class="container py-5">
        <div class="row align-items-center g-4">
            <!-- Bogsy Video Store Description (Left on desktop, Bottom on mobile) -->
            <div class="col-md-6 order-2 order-md-1">
                <section>
                    <h1 class="text-warning fs-5 fw-bold">Bogsy Video Store</h1>
                    <hr class="border-light" />
                    <div>
                        <p class="lead">
                            Bogsy Video Studio (BVS) is a neighborhood entertainment hub located in Buhangin, Davao City,
                            dedicated to providing accessible, budget-friendly home movie rentals to the local community.
                            By offering a curated collection of popular titles on VCD and DVD formats, BVS serves as a reliable
                            go-to spot for families and movie enthusiasts seeking quality home viewing without subscription fees.
                        </p>
                    </div>
                </section>
            </div>

            <!-- Login Form (Right on desktop, Top on mobile) -->
            <div class="col-md-5 offset-md-1 order-1 order-md-2">
                <section class="bg-dark bg-opacity-75 p-4 rounded-3 border border-secondary shadow">
                    <form id="account" method="post">
                        <h2>@ViewData["Title"]</h2>
                        <h3 class="h5 text-light mb-3">Use <strong class="text-warning fs-5 fw-bold">admin@@bvs.com/Admin123!</strong> to log in.</h3>
                        <hr class="border-secondary" />
                        <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>

                        <div class="form-floating mb-3 text-dark">
                            <input asp-for="Input.Email" class="form-control" autocomplete="username" aria-required="true" placeholder="name@example.com" />
                            <label asp-for="Input.Email" class="form-label">Email</label>
                            <span asp-validation-for="Input.Email" class="text-danger"></span>
                        </div>

                        <div class="form-floating mb-3 text-dark">
                            <input asp-for="Input.Password" class="form-control" autocomplete="current-password" aria-required="true" placeholder="password" />
                            <label asp-for="Input.Password" class="form-label">Password</label>
                            <span asp-validation-for="Input.Password" class="text-danger"></span>
                        </div>

                        <div class="checkbox mb-3">
                            <label asp-for="Input.RememberMe" class="form-label text-white">
                                <input class="form-check-input" asp-for="Input.RememberMe" />
                                @Html.DisplayNameFor(m => m.Input.RememberMe)
                            </label>
                        </div>

                        <div>
                            <button id="login-submit" type="submit" class="w-100 btn btn-lg btn-primary">Log in</button>
                        </div>

                        <div class="mt-2">
                            <p>
                                <a id="forgot-password" class="link-light" asp-page="./ForgotPassword">Forgot your password?</a>
                            </p>
                        </div>
                    </form>
                </section>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}